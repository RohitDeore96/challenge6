# HawaSathi environment variables.
# Copy to .env.local for local development and configure the same name
# in Vercel Project Settings -> Environment Variables.
# NEVER prefix the Gemini key with NEXT_PUBLIC_ (it must stay server-side only).

# Server-only Google AI Studio API key (https://aistudio.google.com/apikey)
# The app stays fully functional without it: the deterministic plan still works
# and the UI shows an honest "AI explanation unavailable" state.
GEMINI_API_KEY=replace_with_google_ai_studio_key

# Optional model override (server-side only). If unset the app uses the
# default below; the resolved ID is echoed in every ai.model response.
AI_MODEL=gemini-3.5-flash-lite

